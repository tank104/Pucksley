<Project Sdk="Microsoft.NET.Sdk">
  <!-- The hub as a console app / service: Linux, Docker (e.g. a Synology NAS), macOS, or Windows without the tray. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pucksley.Server</RootNamespace>
    <AssemblyName>pucksley-hub</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Pucksley.Core\Pucksley.Core.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Music\Pucksley.Plugins.Music.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Home\Pucksley.Plugins.Home.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Utility\Pucksley.Plugins.Utility.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Speech\Pucksley.Plugins.Speech.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>
</Project>
