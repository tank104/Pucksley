<Project Sdk="Microsoft.NET.Sdk">
  <!-- The hub on Windows: a tray icon, plus the plugins that control this PC. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Pucksley.Tray</RootNamespace>
    <AssemblyName>Pucksley</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>puck.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Pucksley.Core\Pucksley.Core.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Music\Pucksley.Plugins.Music.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Home\Pucksley.Plugins.Home.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Utility\Pucksley.Plugins.Utility.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Speech\Pucksley.Plugins.Speech.csproj" />
    <ProjectReference Include="..\..\Plugins\Pucksley.Plugins.Windows\Pucksley.Plugins.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="puck.ico" />
  </ItemGroup>
</Project>
