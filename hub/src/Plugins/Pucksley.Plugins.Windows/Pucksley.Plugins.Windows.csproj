<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plugins that control the Windows PC the hub runs on. Only loaded when the hub runs on Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Pucksley.Plugins.Windows</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- SAPI dictation: the "Windows offline recognition" speech-to-text engine -->
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Pucksley.Sdk\Pucksley.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pucksley.Plugins.Windows.Tests" />
  </ItemGroup>
</Project>
