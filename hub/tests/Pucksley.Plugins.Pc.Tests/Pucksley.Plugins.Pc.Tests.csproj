<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the part of the "this PC" plugins that every operating system shares: the PC audio
       plugin against a mixer and media sessions in memory, name matching, and the small helpers.
       They run on Windows and Linux alike. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pucksley.Plugins.Pc.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Plugins\Pucksley.Plugins.Pc\Pucksley.Plugins.Pc.csproj" />
    <ProjectReference Include="..\Pucksley.TestSupport\Pucksley.TestSupport.csproj" />
  </ItemGroup>
</Project>
