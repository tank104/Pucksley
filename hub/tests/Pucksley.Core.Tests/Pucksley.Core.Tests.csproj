<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the hub core: settings and secrets, text/audio helpers, the Claude agent against a fake
    Messages API, and the whole hub end to end with a fake puck on a WebSocket. Nothing external is
    called: no API keys, no devices, no USB, no mDNS, and the data folder is a temp folder.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Pucksley.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pucksley.Core\Pucksley.Core.csproj" />
    <ProjectReference Include="..\..\src\Pucksley.Sdk\Pucksley.Sdk.csproj" />
    <ProjectReference Include="..\Pucksley.TestSupport\Pucksley.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
