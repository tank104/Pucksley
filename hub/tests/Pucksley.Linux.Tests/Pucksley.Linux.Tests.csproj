<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the Linux desktop host: the tray menu's contents, the icon, and the files it writes to
       put itself in the app launcher and the login. Nothing is written outside a temporary folder,
       and no tray is needed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pucksley.Linux.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- They run on Linux only; elsewhere the project is just built -->
    <IsTestProject Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsTestProject>
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Linux'))">false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hosts\Pucksley.Linux\Pucksley.Linux.csproj" />
  </ItemGroup>
</Project>
